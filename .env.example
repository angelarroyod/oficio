# Copy to .env and fill with your Supabase project values.
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time.
# The anon key is safe to ship publicly — Row Level Security is what protects data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-public-key

# OAuth redirect scheme is defined in app.json ("scheme": "oficio").
# Configure the Supabase Google + Apple providers in the Supabase dashboard.
